* {
    font-family: "Terminus";
    font-size: 15px;
    font-weight: normal;
    color: {{colors.on_surface.default.hex}};
    background-color: #000000;
    padding: 0px 2px;
    margin: 0px;
    border-radius: 0px;
}

#bar { background-color: #000000; margin: 0px; }

#tags          { background-color: #000000; color: {{colors.on_surface_variant.default.hex}}; padding: 0px 6px; }
#tags.occupied { background-color: #000000; color: {{colors.on_surface_variant.default.hex}}; }
#tags.empty    { background-color: #000000; color: {{colors.on_surface_variant.default.hex}}; }
#tags.active   { background-color: {{colors.primary.default.hex}}; color: {{colors.on_primary.default.hex}}; }
#tags.urgent   { background-color: {{colors.error.default.hex}}; color: {{colors.on_error.default.hex}}; }
